rules_version = '2';

// Paste this into Firebase Console > Firestore Database > Rules, or deploy
// with the Firebase CLI (`firebase deploy --only firestore:rules`).
//
// Data model:
//   users/{uid}                        - profile + role ('couple' | 'superadmin' | 'vip').
//                                         A 'vip' account additionally carries
//                                         vipApprovalStatus ('pending' | 'approved' |
//                                         'rejected') - VIP Cinematic is a wholly
//                                         separate, admin-approved tier with its own
//                                         sign-up/login/dashboard at /vip, not a
//                                         feature a regular 'couple' account can turn
//                                         on. Only a superadmin's write can ever set
//                                         vipApprovalStatus to 'approved' - see below.
//   slugs/{slug}                       - { weddingId } reservation, public read
//   weddings/{weddingId}               - one per couple (or one per VIP account),
//                                         owned by ownerUid
//   weddings/{weddingId}/guests/{id}   - full RSVP data (dietary, phone, etc.)
//                                         PRIVATE: only the owner or a superadmin can read
//   weddings/{weddingId}/wishes/{id}   - public-safe subset (name + message only)
//                                         used by the live Wishes Wall
//   weddings/{weddingId}/billingRequests/{id} - a couple's own "please upgrade
//                                         me to Premium" requests. PRIVATE:
//                                         only the owner (create/read their
//                                         own) or a superadmin (read/update
//                                         to approve/decline) can touch these.
//   weddings/{weddingId}/physicalOrders/{id} - a couple's own physical card
//                                         orders (see usePhysicalOrders.ts).
//                                         Same shape as billingRequests:
//                                         PRIVATE, owner can create/read
//                                         their own as 'pending', only a
//                                         superadmin can update the status
//                                         as it moves through fulfillment.
//                                         AdminPhysicalOrders.vue reads
//                                         across every wedding at once via a
//                                         collectionGroup('physicalOrders')
//                                         query, which this same rule covers.
//
// The guests/wishes split exists specifically so the full guest list (phone
// numbers, dietary needs, guest counts) never has to be publicly readable -
// unlike a flatter model, nobody can query someone else's guest list just by
// opening dev tools.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    function isOwner(weddingData) {
      return isSignedIn() && request.auth.uid == weddingData.ownerUid;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      // A superadmin can update any profile (needed to approve/decline a
      // VIP request - see AdminVipApprovals.vue). Otherwise, a user can
      // only update their own profile, can't grant themselves the
      // superadmin role, and can never write 'approved' as their own
      // vipApprovalStatus - they can request ('pending') but only a
      // superadmin's write can actually grant VIP access.
      allow update: if isSuperAdmin() || (
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.vipApprovalStatus != 'approved'
      );
    }

    match /slugs/{slug} {
      allow read: if true; // needed to resolve /w/{slug} public pages
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Shared, non-personal catalog used by the dashboard pickers. It must be
    // readable so a saved custom theme/font/preset can render correctly.
    // Only a superadmin may change it.
    match /platformCatalog/{catalogId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /weddings/{weddingId} {
      allow read: if resource.data.status == 'published' || isOwner(resource.data) || isSuperAdmin();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner(resource.data) || isSuperAdmin();

      match /guests/{guestId} {
        allow create: if true; // public RSVP submission
        allow read: if isOwner(get(/databases/$(database)/documents/weddings/$(weddingId)).data) || isSuperAdmin();
        allow update, delete: if isOwner(get(/databases/$(database)/documents/weddings/$(weddingId)).data);
      }

      match /wishes/{wishId} {
        allow read: if true; // powers the public live Wishes Wall
        allow create: if true;
        allow update, delete: if false;
      }

      match /billingRequests/{requestId} {
        allow read: if isOwner(get(/databases/$(database)/documents/weddings/$(weddingId)).data) || isSuperAdmin();
        // A couple can only ever file a new request as 'pending' for their
        // own wedding - only a superadmin can flip it to approved/declined.
        allow create: if isOwner(get(/databases/$(database)/documents/weddings/$(weddingId)).data) &&
          request.resource.data.status == 'pending';
        allow update: if isSuperAdmin();
        allow delete: if false;
      }

      match /physicalOrders/{orderId} {
        allow read: if isOwner(get(/databases/$(database)/documents/weddings/$(weddingId)).data) || isSuperAdmin();
        // Same shape as billingRequests: a couple can only ever file a new
        // order as 'pending' for their own wedding - only a superadmin can
        // move it through confirmed/in_production/shipped/delivered (or
        // cancel it).
        allow create: if isOwner(get(/databases/$(database)/documents/weddings/$(weddingId)).data) &&
          request.resource.data.status == 'pending';
        allow update: if isSuperAdmin();
        allow delete: if false;
      }
    }
  }
}
