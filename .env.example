# ---- Site ----
# Used to build shareable links (QR codes, WhatsApp invites, print QR codes).
# Set to your real domain in production, e.g. https://yourdomain.com
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Firebase (public - safe to expose to the browser) ----
# From Firebase console > Project settings > General > Your apps > SDK setup and configuration
# Enable Authentication (Email/Password + Google) and Firestore.
# NOTE: Firebase Storage is NOT required - cover photo uploads use Cloudinary
# instead (see below), because Firebase Storage now requires the paid Blaze
# plan even for free-tier usage (effective Feb 2026). If you're already on
# Blaze and would rather use Firebase Storage, see storage.rules.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# ---- Cloudinary (public - safe to expose to the browser) ----
# Free plan, no credit card required: https://cloudinary.com
# 1. Sign up, then find your Cloud Name on the dashboard home page.
# 2. Settings (gear icon) > Upload > Upload presets > Add upload preset
#    > set Signing Mode to "Unsigned" > Save > copy its name.
# Powers the cover photo uploader on /dashboard/editor.
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NUXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---- Billplz (reserved, not wired up yet) ----
# The Billing page currently only previews plans/pricing - see the README's
# "What's next" section for wiring this up for real.
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_SANDBOX=true
